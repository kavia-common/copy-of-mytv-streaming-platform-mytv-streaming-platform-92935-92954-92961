# PUBLIC_INTERFACE
# Example environment variables for MyTV Frontend (Create React App)
# Copy to .env and customize as needed. Do NOT commit actual secrets.

# Binding and behavior
HOST=0.0.0.0
PORT=3000
BROWSER=none
REACT_APP_HOST=0.0.0.0
REACT_APP_PORT=3000
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=warn

# Feature flags
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
REACT_APP_ENABLE_SOURCE_MAPS=true

# API endpoints
REACT_APP_API_BASE=http://localhost:8000
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:8000

# Environment/telemetry
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
