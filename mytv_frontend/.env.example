# Build-time environment variables for MyTV frontend (Create React App)
# Note: These are read at build-time. Do not prefix with anything other than REACT_APP_.

# If you have a backend API, provide an absolute HTTPS URL. If left empty or relative, the app will use the mock API:
# https://5bc9cfc0.api.kavia.app
REACT_APP_API_BASE=

# Alternative backend base (absolute URL). If both are set, REACT_APP_API_BASE takes precedence.
REACT_APP_BACKEND_URL=

# Frontend/site absolute URL (optional)
REACT_APP_FRONTEND_URL=

# WebSocket URL (optional)
REACT_APP_WS_URL=

# Environment name (development|production)
REACT_APP_NODE_ENV=development

# Optional flags
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
