# MyTV Frontend - Example Environment Variables
# Copy this file to `.env` and adjust values as needed.

# Existing variables (examples only)
REACT_APP_API_BASE=https://api.example.com
REACT_APP_BACKEND_URL=https://backend.example.com
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3001
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=1
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=0
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=0

# Subtitles (optional external WebVTT tracks)
# If provided, these will be registered with Shaka as text tracks and appear
# in the PlayerOverlay language selector alongside any embedded tracks.
# Supported languages currently: English (en) and Spanish (es).
# Notes:
# - Use absolute URLs or paths resolvable by the frontend (CORS must allow it).
# - MIME type must be text/vtt.
# - When both embedded and external tracks exist for a language, either may be used.
REACT_APP_SUBTITLE_VTT_URL_EN=
REACT_APP_SUBTITLE_VTT_URL_ES=
